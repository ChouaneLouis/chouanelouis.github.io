---
import Experience from './Experience.astro'
import type { ExperienceData } from '../data/schema';

interface Props {
    experiences: ExperienceData[];
}

const { experiences } = Astro.props;
---

<section class="bg-blue-950 text-white" id="experiences">
    <div class="max-w-280 mx-auto pt-10 pb-15 px-2 w-full">
        <h2 class="text-4xl text-center font-alfa md:text-left">Experiences pro</h2>
        <div class="flex flex-col gap-10 mt-4">
            {experiences.map((experience) => (
                <Experience experience={ experience } />
            ))}
        </div>
    </div>
</section>
