---
import type { ProjectData } from '../data/schema';

interface Props {
  project: ProjectData;
}

const { project } = Astro.props;
---

<article class="border-l-15 border-black/15 pl-2">
    <h3 class="text-2xl font-bold">{ project.title }</h3>
    <p class="mt-2">{ project.description }</p>
    <ul class="flex flex-wrap italic gap-x-5 mt-2">
        {project.techStack.map((tech) => (
            <li>{ tech }</li>
        ))}
    </ul>
</article>
