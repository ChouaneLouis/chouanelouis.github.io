---
import Project from './Project.astro'
import type { ProjectData } from '../data/schema';

interface Props {
    projects: ProjectData[];
}

const { projects } = Astro.props;
---

<section class="bg-teal-800 text-white" id="projects">
    <div class="max-w-280 mx-auto pt-10 pb-15 px-2 w-full">
        <h2 class="text-4xl text-center font-alfa md:text-left">Projets</h2>
        <div class="flex flex-col gap-10 mt-4">
            {projects.map((project) => (
                <Project project={ project } />
            ))}
        </div>
    </div>
</section>
